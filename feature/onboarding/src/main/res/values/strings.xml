    <string name="onboarding_cancel">Cancel</string>

    <string name="onboarding_display_name_title">Choose your name</string>
    <string name="onboarding_display_name_explanation">People see this name in your chats. You can change it later.</string>
    <string name="onboarding_display_name_label">Display name</string>
    <string name="onboarding_submit">Create account</string>
    <string name="onboarding_submitting">Creating account</string>

    <string name="onboarding_recovery_title">Save your recovery code</string>
    <string name="onboarding_recovery_explanation">This code is the only way to get your account back if you lose all your devices. It is shown only this once: write it down and keep it somewhere safe.</string>
    <string name="onboarding_recovery_code_description">Recovery code %1$s</string>
    <string name="onboarding_copy_code">Copy code</string>
    <string name="onboarding_code_copied">Copied</string>
    <string name="onboarding_code_saved">I have saved my recovery code</string>
    <string name="onboarding_continue">Continue</string>

    <string name="onboarding_handle_title">Choose a handle</string>
    <string name="onboarding_handle_explanation">Other people can find you by your handle. You can also claim one later.</string>
    <string name="onboarding_handle_label">Handle</string>
    <string name="onboarding_handle_supporting">3–32 characters: a–z, 0–9 and underscore</string>
    <string name="onboarding_claim_handle">Claim handle</string>
    <string name="onboarding_claiming_handle">Claiming handle</string>
    <string name="onboarding_skip">Skip for now</string>

    <string name="onboarding_link_qr_title">Scan with your other device</string>
    <string name="onboarding_link_qr_explanation">On a device where you are signed in, open the menu in Chats, choose “Link a new device” and scan this code.</string>
    <string name="onboarding_link_qr_description">Link code</string>
    <string name="onboarding_link_waiting">Waiting for your other device…</string>
    <string name="onboarding_link_copy">Copy code instead</string>
    <string name="onboarding_link_retry">Show a new code</string>
    <string name="onboarding_link_sas_title">Compare the codes</string>
    <string name="onboarding_link_sas_explanation">Your other device shows a code too. Confirm only if both codes are the same.</string>
    <string name="onboarding_link_confirm">The codes match</string>
    <string name="onboarding_link_confirming">Linking device</string>
    <string name="onboarding_link_reject">They don’t match</string>

    <string name="onboarding_restore_title">Restore your account</string>
    <string name="onboarding_restore_explanation">Enter your user ID and the recovery code you saved when you created the account. Chats are not restored: other members need to add this device again.</string>
    <string name="onboarding_user_id_label">User ID</string>
    <string name="onboarding_user_id_supporting">Starts with “u”. Find it under Devices on a signed-in device.</string>
    <string name="onboarding_restore_code_label">Recovery code</string>
    <string name="onboarding_restore_code_supporting">39 characters; dashes and spaces are optional</string>
    <string name="onboarding_restore_revoke_others">Sign out all other devices</string>
    <string name="onboarding_restore_submit">Restore account</string>
    <string name="onboarding_restoring">Restoring account</string>

