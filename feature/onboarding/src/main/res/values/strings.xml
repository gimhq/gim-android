    <string name="onboarding_kit_file_title">gim recovery kit</string>
    <string name="onboarding_kit_file_note">Keep this secret. Anyone who has it can get into your account. Lost all your devices? Open gim, tap “Restore with your recovery kit” and paste this text.</string>

    <string name="onboarding_kit_check_title">Check your recovery key</string>
    <string name="onboarding_kit_check_explanation">Type the last 4 characters of your recovery key. This makes sure you saved it.</string>
    <string name="onboarding_kit_check_label">Last 4 characters</string>
    <string name="onboarding_kit_check_confirm">Confirm</string>

    <string name="onboarding_handle_title">Choose a username</string>
    <string name="onboarding_handle_explanation">Friends can find you with it. It’s optional. You can add one later.</string>
    <string name="onboarding_handle_label">Username</string>
    <string name="onboarding_handle_supporting">3–32 characters: a–z, 0–9 and _</string>
    <string name="onboarding_claim_handle">Save username</string>
    <string name="onboarding_claiming_handle">Saving username</string>
    <string name="onboarding_skip">Skip for now</string>

    <string name="onboarding_link_qr_title">Scan with your other device</string>
    <string name="onboarding_link_qr_explanation">On a device where you use gim, open the menu in Chats. Choose “Link a new device” and scan this code.</string>
    <string name="onboarding_link_qr_description">Link code</string>
    <string name="onboarding_link_waiting">Waiting for your other device…</string>
