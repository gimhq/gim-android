<resources>
    <string name="onboarding_welcome_title">Welcome to gim</string>
    <string name="onboarding_welcome_explanation">Enter the address of your hub, then create a new account or use one you already have.</string>
    <string name="onboarding_server_url_label">Hub address</string>
    <string name="onboarding_server_url_placeholder">https://</string>
    <string name="onboarding_create_account">Create new account</string>
