    <string name="onboarding_link_sas_title">Compare the codes</string>
    <string name="onboarding_link_sas_explanation">Your other device shows a code too. Tap “The codes match” only if both are the same.</string>
    <string name="onboarding_link_confirm">The codes match</string>
    <string name="onboarding_link_confirming">Linking device</string>
    <string name="onboarding_link_reject">They don’t match</string>

    <string name="onboarding_restore_title">Restore your account</string>
    <string name="onboarding_restore_explanation">Use the recovery kit you saved when you made your account. Old chats don’t come back. Friends need to add you to groups again.</string>
    <string name="onboarding_restore_kit_label">Paste your recovery kit</string>
    <string name="onboarding_restore_kit_supporting">Paste all of it. We find your Account ID and recovery key in it.</string>
    <string name="onboarding_restore_manual_title">Or type them yourself</string>
    <string name="onboarding_user_id_label">Account ID</string>
    <string name="onboarding_user_id_supporting">Starts with “u”. It’s in your recovery kit.</string>
    <string name="onboarding_restore_code_label">Recovery key</string>
    <string name="onboarding_restore_code_supporting">39 characters. Dashes and spaces are fine.</string>
